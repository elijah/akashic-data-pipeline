{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".",
    "./connector/src/connectors/**/*.js",
    "./connector/src/connectors/**/*.ts",
    "./lib/geo-intelligence/connectors/**/*.ts",
    "./lib/geo-intelligence/connectors/**/*.ts",
    "./lib/types.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "**/*test*",
    "**/*mock*"
  ]
}
